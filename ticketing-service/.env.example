DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=ticketing
REDIS_HOST=localhost
REDIS_PORT=6379
# How long a reserved ticket is held pending payment before it's released back to inventory
RESERVATION_TTL_SECONDS=60
# How long a customer may stay on Stripe Checkout before the worker expires the session
CHECKOUT_HOLD_SECONDS=60
# Stripe secret key (test or live) - see https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Stripe webhook signing secret - see https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=
# Base URL of the frontend, used for Stripe Checkout success/cancel redirects
CLIENT_URL=http://localhost:4242
