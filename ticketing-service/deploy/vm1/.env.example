# --- Docker image (Docker Hub) ---
IMAGE_REPO=your-dockerhub-user/ticketing-service
# Tag of the API image (built with `docker build --target api`)
API_TAG=api

# --- Postgres (shared with VM2's worker — same values on both VMs) ---
DB_USERNAME=postgres
# Generate a strong password: `openssl rand -base64 32`
DB_PASSWORD=CHANGE_ME
DB_DATABASE=ticketing

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Base URL of your frontend, used for Stripe Checkout redirects
CLIENT_URL=http://localhost:4242

# --- Optional timing overrides (defaults shown) ---
# RESERVATION_TTL_SECONDS=60
# CHECKOUT_HOLD_SECONDS=60
