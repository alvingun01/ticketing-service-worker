# --- Docker image (Docker Hub) ---
IMAGE_REPO=your-dockerhub-user/ticketing-service
# Tag of the worker image (built with `docker build --target worker`)
WORKER_TAG=worker

# --- Point at VM1's datastores over its external IP ---
VM1_PUBLIC_IP=34.123.45.67

# --- Postgres credentials (MUST match VM1 exactly) ---
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME
DB_DATABASE=ticketing

# --- Stripe (worker expires Checkout sessions; no webhook secret needed) ---
STRIPE_SECRET_KEY=sk_test_...

# --- Optional timing overrides (defaults shown) ---
# RESERVATION_TTL_SECONDS=60
# CHECKOUT_HOLD_SECONDS=60
